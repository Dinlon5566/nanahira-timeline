---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// fallback target (ja) if JS disabled
const fallback = `${base}/ja/`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <link rel="canonical" href={fallback} />
    <title>ななひら Discography Timeline</title>
    <script is:inline define:vars={{ base }}>
      (function () {
        var LANGS = ['ja', 'en', 'zh'];
        // 1. honour explicit preference from previous visit
        var saved = (function () {
          try { return localStorage.getItem('preferredLang'); } catch (e) { return null; }
        })();
        if (saved && LANGS.indexOf(saved) !== -1) {
          location.replace(base + '/' + saved + '/');
          return;
        }
        // 2. detect from navigator.languages (ordered by user preference)
        var langs = (navigator.languages && navigator.languages.length)
          ? navigator.languages
          : [navigator.language || navigator.userLanguage || 'ja'];
        var pick = 'ja';
        for (var i = 0; i < langs.length; i++) {
          var l = (langs[i] || '').toLowerCase();
          if (l.indexOf('ja') === 0) { pick = 'ja'; break; }
          if (l.indexOf('zh') === 0) { pick = 'zh'; break; }
          if (l.indexOf('en') === 0) { pick = 'en'; break; }
        }
        location.replace(base + '/' + pick + '/');
      })();
    </script>
  </head>
  <body>
    <p><a href={fallback}>ななひら Discography Timeline</a></p>
  </body>
</html>
