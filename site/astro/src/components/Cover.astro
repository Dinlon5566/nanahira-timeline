---
import type { Cover } from '../lib/dataTypes';

interface Props {
  cover: Cover | null;
  alt: string;
  size?: number;
}
const { cover, alt, size = 96 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Absolute (http/https) cover URLs pass through untouched (e.g. remote YouTube thumbnails);
// repo-local paths are resolved under BASE_URL.
const rawUrl = cover?.url ?? '';
const isRemote = rawUrl.startsWith('http://') || rawUrl.startsWith('https://');
const full = isRemote ? rawUrl : `${base}/${rawUrl}`;
// Local covers render from a pre-generated 192px WebP (scripts/generate_thumbs.py);
// the lightbox swaps in data-full, and onerror covers thumbs not yet generated.
const thumb = isRemote
  ? full
  : `${base}/${rawUrl.replace(/^covers\//, 'covers/thumb/').replace(/\.jpg$/i, '.webp')}`;
---
{cover && (
  <div class="card-cover">
    <img
      src={thumb}
      alt={alt}
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      data-full={full}
      onerror="this.onerror=null;this.src=this.dataset.full||this.src"
      data-zoomable
    />
  </div>
)}
