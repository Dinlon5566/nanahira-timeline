---
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<nav class="filters" aria-label="Filters">
  <fieldset class="filter-group">
    <legend>{t(lang, 'filter.display')}</legend>
    <label><input type="checkbox" checked data-filter="type-release" /> {t(lang, 'filter.release')}</label>
    <label><input type="checkbox" checked data-filter="type-milestone" /> {t(lang, 'filter.milestone')}</label>
  </fieldset>
  <fieldset class="filter-group">
    <legend>{t(lang, 'filter.role')}</legend>
    <label><input type="checkbox" checked data-filter="role-lead" /> {t(lang, 'filter.role.lead')}</label>
    <label><input type="checkbox" checked data-filter="role-guest" /> {t(lang, 'filter.role.guest')}</label>
    <label><input type="checkbox" checked data-filter="role-tiein" /> {t(lang, 'filter.role.tiein')}</label>
  </fieldset>
  <button
    class="expand-all"
    type="button"
    data-state="0"
    data-label0={t(lang, 'expand.collapsed')}
    data-label1={t(lang, 'expand.tracklists')}
    data-label2={t(lang, 'expand.full')}
  >
    <span class="expand-label">{t(lang, 'expand.collapsed')}</span>
    <span class="expand-arrow">▾</span>
  </button>
</nav>
