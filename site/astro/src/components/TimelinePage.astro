---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from './FilterBar.astro';
import YearSection from './YearSection.astro';
import YearNav from './YearNav.astro';
import type { Album, Track, Timeline } from '../lib/dataTypes';
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import albumsData from '../data/albums.json';
import tracksData from '../data/tracks.json';
import timelineData from '../data/timeline.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const albums = albumsData as Album[];
const tracks = tracksData as Track[];
const timeline = timelineData as Timeline;

const albumMap: Record<string, Album> = Object.fromEntries(albums.map(a => [a.id, a]));
const tracksByAlbum: Record<string, Track[]> = {};
for (const tr of tracks) {
  (tracksByAlbum[tr.album_id] ??= []).push(tr);
}

const currentYear = new Date().getFullYear();
const yearNums = timeline.years.map(y => y.year);
const yearSpan = `${Math.min(...yearNums)}–${Math.max(...yearNums)}`;
---
<BaseLayout lang={lang}>
  <section class="intro">
    <p class="intro-lead">{t(lang, 'intro.lead')}</p>
    <p class="intro-body">{t(lang, 'intro.body')}</p>
    <ul class="intro-stats">
      <li>
        <span class="stat-num">{timeline.total_releases.toLocaleString('en-US')}</span>
        <span class="stat-label">{t(lang, 'intro.stat.releases')}</span>
      </li>
      <li>
        <span class="stat-num">{tracks.length.toLocaleString('en-US')}</span>
        <span class="stat-label">{t(lang, 'intro.stat.tracks')}</span>
      </li>
      <li>
        <span class="stat-num">{yearSpan}</span>
        <span class="stat-label">{t(lang, 'intro.stat.years')}</span>
      </li>
    </ul>
  </section>
  <FilterBar lang={lang} />
  <YearNav years={timeline.years} />
  <div class="timeline">
    {timeline.years.map(y => (
      <YearSection
        year={y}
        albumMap={albumMap}
        tracksByAlbum={tracksByAlbum}
        lang={lang}
        defaultOpen={y.year >= currentYear - 2}
      />
    ))}
  </div>

  <script>
    // Year-nav click → ensure target year is open
    document.querySelectorAll<HTMLAnchorElement>('.year-nav a').forEach(link => {
      link.addEventListener('click', () => {
        const year = link.dataset.year;
        if (!year) return;
        pauseAutoExpand(); // years flown past during the smooth jump stay collapsed
        const sec = document.getElementById(`year-${year}`);
        if (!sec) return;
        delete sec.dataset.userClosed;
        if (!sec.hasAttribute('open')) {
          sec.setAttribute('open', '');
          sec.querySelector('.year-toggle')?.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Auto-expand collapsed years as they scroll near (400px early, so the
    // timeline reads as continuous). Years the user collapsed by hand stay shut.
    let autoExpandPaused = false;
    let resumeTimer: number | undefined;
    const autoExpand = new IntersectionObserver((entries) => {
      if (autoExpandPaused) return;
      entries.forEach(en => {
        if (!en.isIntersecting) return;
        const sec = en.target as HTMLElement;
        if (sec.hasAttribute('open') || sec.dataset.userClosed) return;
        // only open years still below the fold — opening one already on screen
        // (after a nav jump, or entering from the top while scrolling up)
        // grows the page mid-viewport and yanks the view
        if (en.boundingClientRect.top < window.innerHeight) return;
        sec.setAttribute('open', '');
        sec.querySelector('.year-toggle')?.setAttribute('aria-expanded', 'true');
      });
    }, { rootMargin: '0px 0px 400px 0px' });
    document.querySelectorAll('.year').forEach(s => autoExpand.observe(s));

    // Direct links like /ja/#year-2008 land on a collapsed section — open it
    const hashSec = /^#year-\d{4}$/.test(location.hash)
      ? document.getElementById(location.hash.slice(1))
      : null;
    if (hashSec && !hashSec.hasAttribute('open')) {
      hashSec.setAttribute('open', '');
      hashSec.querySelector('.year-toggle')?.setAttribute('aria-expanded', 'true');
      hashSec.scrollIntoView({ behavior: 'instant' as ScrollBehavior });
    }

    // Fill the first screen: while still at the top of the page, opening the
    // years in or near view only grows the page downward — nothing visibly moves.
    if (window.scrollY < 100) {
      document.querySelectorAll<HTMLElement>('.year:not([open])').forEach(sec => {
        if (sec.dataset.userClosed) return;
        if (sec.getBoundingClientRect().top < window.innerHeight + 400) {
          sec.setAttribute('open', '');
          sec.querySelector('.year-toggle')?.setAttribute('aria-expanded', 'true');
        }
      });
    }

    function pauseAutoExpand() {
      autoExpandPaused = true;
      clearInterval(resumeTimer);
      // smooth jumps have no fixed duration — resume once the position settles
      // (scrollend below resumes sooner where supported)
      let lastY = -1;
      resumeTimer = window.setInterval(() => {
        if (Math.abs(window.scrollY - lastY) < 2) resumeAutoExpand();
        lastY = window.scrollY;
      }, 250);
    }
    function resumeAutoExpand() {
      clearInterval(resumeTimer);
      if (!autoExpandPaused) return;
      autoExpandPaused = false;
      // re-observe so a year already sitting inside the margin gets re-evaluated
      document.querySelectorAll('.year').forEach(s => { autoExpand.unobserve(s); autoExpand.observe(s); });
    }
    window.addEventListener('scrollend', resumeAutoExpand);

    // Active year highlight
    const navLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.year-nav a').forEach(a => {
      if (a.dataset.year) navLinks.set(a.dataset.year, a);
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        const y = (en.target as HTMLElement).dataset.year;
        if (!y) return;
        const link = navLinks.get(y);
        if (!link) return;
        if (en.isIntersecting) link.classList.add('is-active');
        else link.classList.remove('is-active');
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    document.querySelectorAll('.year').forEach(s => observer.observe(s));

    // Year section collapse
    document.querySelectorAll<HTMLButtonElement>('.year-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const sec = btn.closest<HTMLElement>('.year')!;
        const isOpen = sec.hasAttribute('open');
        if (isOpen) {
          sec.removeAttribute('open');
          sec.dataset.userClosed = '1'; // scroll auto-expand must not reopen it
          btn.setAttribute('aria-expanded', 'false');
        } else {
          delete sec.dataset.userClosed;
          sec.setAttribute('open', '');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Tracklist expand — swap the arrow suffix only (preserving the translated label)
    document.querySelectorAll<HTMLButtonElement>('.expand').forEach(btn => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('.card-info')?.querySelector<HTMLElement>('.tracklist-wrap');
        if (!wrap) return;
        const show = wrap.hidden;
        wrap.hidden = !show;
        btn.setAttribute('aria-expanded', show ? 'true' : 'false');
        // keep translated label, just swap arrow
        btn.textContent = btn.textContent!.replace(/[▴▾]/g, show ? '▴' : '▾');
      });
    });

    // Show-all toggle inside tracklist
    document.querySelectorAll<HTMLButtonElement>('.track-toggle-all').forEach(btn => {
      btn.addEventListener('click', () => {
        const tl = btn.previousElementSibling;
        if (!tl || !tl.classList.contains('tracklist')) return;
        const show = tl.classList.toggle('show-all');
        const showLabel = btn.querySelector<HTMLElement>('[data-label-show]');
        const hideLabel = btn.querySelector<HTMLElement>('[data-label-hide]');
        if (showLabel && hideLabel) {
          showLabel.hidden = show;
          hideLabel.hidden = !show;
        }
      });
    });

    // Expand-all cycle button (3-state)
    const expandBtn = document.querySelector<HTMLButtonElement>('.expand-all');
    if (expandBtn) {
      const labelEl = expandBtn.querySelector<HTMLElement>('.expand-label')!;
      const arrowEl = expandBtn.querySelector<HTMLElement>('.expand-arrow')!;
      const LABELS = [
        expandBtn.dataset.label0 || '',
        expandBtn.dataset.label1 || '',
        expandBtn.dataset.label2 || '',
      ];
      const ARROWS = ['▾', '▴', '▾'];
      expandBtn.addEventListener('click', () => {
        const state = Number(expandBtn.dataset.state || '0');
        const next = (state + 1) % 3;
        expandBtn.dataset.state = String(next);
        labelEl.textContent = LABELS[next];
        arrowEl.textContent = ARROWS[next];

        const wraps = document.querySelectorAll<HTMLElement>('.tracklist-wrap');
        const expands = document.querySelectorAll<HTMLButtonElement>('.expand');
        const tracklists = document.querySelectorAll<HTMLElement>('.tracklist');

        if (next === 0) {
          wraps.forEach(w => { w.hidden = true; });
          expands.forEach(b => {
            b.setAttribute('aria-expanded', 'false');
            b.textContent = b.textContent!.replace(/[▴▾]/g, '▾');
          });
          tracklists.forEach(tl => tl.classList.remove('show-all'));
        } else if (next === 1) {
          wraps.forEach(w => { w.hidden = false; });
          expands.forEach(b => {
            b.setAttribute('aria-expanded', 'true');
            b.textContent = b.textContent!.replace(/[▴▾]/g, '▴');
          });
          tracklists.forEach(tl => tl.classList.remove('show-all'));
        } else {
          wraps.forEach(w => { w.hidden = false; });
          expands.forEach(b => {
            b.setAttribute('aria-expanded', 'true');
            b.textContent = b.textContent!.replace(/[▴▾]/g, '▴');
          });
          tracklists.forEach(tl => tl.classList.add('show-all'));
          document.querySelectorAll<HTMLButtonElement>('.track-toggle-all').forEach(btn => {
            const showLabel = btn.querySelector<HTMLElement>('[data-label-show]');
            const hideLabel = btn.querySelector<HTMLElement>('[data-label-hide]');
            if (showLabel && hideLabel) { showLabel.hidden = true; hideLabel.hidden = false; }
          });
        }
      });
    }

    // Filters
    const filterState = {
      'type-release': true, 'type-milestone': true,
      'role-lead': true, 'role-guest': true, 'role-tiein': true,
    };
    function apply() {
      document.querySelectorAll<HTMLElement>('.event').forEach(ev => {
        const type = ev.dataset.type || '';
        const role = ev.dataset.role || '';
        const hiddenByType = !filterState[`type-${type}` as keyof typeof filterState];
        const hiddenByRole = type === 'release' && role && !filterState[`role-${role}` as keyof typeof filterState];
        ev.classList.toggle('is-hidden-type', hiddenByType);
        ev.classList.toggle('is-hidden-role', !!hiddenByRole);
      });
    }
    document.querySelectorAll<HTMLInputElement>('[data-filter]').forEach(inp => {
      inp.addEventListener('change', () => {
        const k = inp.dataset.filter as keyof typeof filterState;
        filterState[k] = inp.checked;
        apply();
      });
    });
  </script>
</BaseLayout>
